# Copy to .env on the CPU box and fill in. setup-cpu-box.sh generates the secrets for you.

# Bearer token for the LeadScout API
API_TOKEN=
# Where the API listens. Keep 127.0.0.1, or set your WireGuard IP to reach it from the office.
API_BIND=127.0.0.1

# Optional: hostname to publish the API on over HTTPS (Caddy), e.g. leads-api.yourdomain.com,
# so your website's backend can call it. Point a DNS A record at this box first.
PUBLIC_HOSTNAME=

# SearXNG session secret
SEARXNG_SECRET=

# LLM endpoint (the GPU instance tunnels vLLM to this port). Key must match LLM_API_KEY on the GPU box.
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=
LLM_MODEL=leadscout
LLM_THINKING=false

# Optional: OpenCorporates API token for Secretary of State records (officers, agent, status).
# Without it the agent falls back to web search for registration data.
OPENCORPORATES_API_TOKEN=

# Identify your crawler honestly; some sites block anonymous agents.
FETCH_USER_AGENT=LeadScout/0.1 (business research; contact: you@yourcompany.com)

# Optional: Slack/Teams incoming webhook or an ntfy topic URL for "deploy GPU" / "destroy GPU" notices
NOTIFY_WEBHOOK_URL=

AGENT_MAX_STEPS=24

# Cost meter: what the GPU instance costs per hour while it exists (Hostinger RTX PRO 6000,
# 2 cores / 64 GB = 75 credits/hour, about EUR 0.75). Shown as estimates in the portal.
GPU_COST_PER_HOUR=0.75
COST_CURRENCY=€
