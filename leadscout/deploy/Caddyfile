# Public HTTPS front for LeadScout. Certificates are issued automatically (Let's Encrypt).
# Serves the browser portal (Base44 sign-in handoff or admin password) and the token API.
# The app itself has no docs/OpenAPI routes and requires a session or token everywhere else.
{$PUBLIC_HOSTNAME} {
	encode gzip

	request_body {
		max_size 8MB
	}
	reverse_proxy 127.0.0.1:8090

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	log {
		output stdout
	}
}
